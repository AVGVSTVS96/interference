#!/bin/sh
# Builds the Interference app as committed here with xtool on this server, signs it on the Mac with the team's development certificate
# (xtool only makes the profile and signs ad hoc; scripts/resign signs where the key is), and puts it on hangar for
# the phone to install. Never let xtool revoke a certificate to make its own: that
# breaks everything the Mac signs (stdin is closed, so it can't ask). The build number is the commit count, and the
# server's address comes from ./config (HANGAR_URL).
# Usage: scripts/phone
set -e
cd "$(dirname "$0")/.."
repo=$PWD
. ./config
build=$HOME/.cache/interference/build
number=$(git rev-list --count HEAD)
rm -rf "$build" && mkdir -p "$build"
git archive HEAD app | tar -x -C "$build" --strip-components=1
python3 - "$build/Info.plist" "$number" "$HANGAR_URL" <<'PY'
import plistlib, sys
path, number, url = sys.argv[1:]
info = plistlib.load(open(path, "rb"))
info["CFBundleVersion"] = number
info["HangarURL"] = url
info["CFBundleURLTypes"][0]["CFBundleURLSchemes"].append(f"com.shahidy.interference-{number}")
plistlib.dump(info, open(path, "wb"))
PY
cd "$build"
TURN=interference xtool dev build -c release --sign < /dev/null
sdk=$(llvm-otool -l xtool/Interference.app/Interference | awk '/LC_BUILD_VERSION/ {b=1} b && $1 == "sdk" {print $2; exit}')
[ "$(printf '%s\n27.1\n' "$sdk" | sort -V | head -1)" = 27.1 ] ||
  { echo "Interference is linked against iOS SDK $sdk; below 27.1 the iPhone Duo runs it as an old iPhone app" >&2; exit 1; }
serial=$(python3 -c "
import glob, os, plistlib, subprocess
path = max(glob.glob(os.path.expanduser('~/.config/xtool/data/??????????')), key=os.path.getmtime)
der = plistlib.load(open(path, 'rb'))['certificate']
print(subprocess.run(['openssl', 'x509', '-inform', 'DER', '-noout', '-serial'], input=der, capture_output=True).stdout.decode().split('=')[1].strip())")
ssh mac 'rm -rf Developer/interference-phone && mkdir -p Developer/interference-phone'
rsync -a xtool/Interference.app mac:Developer/interference-phone/
ssh mac sh -s "$serial" Developer/interference-phone/Interference.app < "$repo/scripts/resign"
ssh mac 'cd Developer/interference-phone && mkdir Payload && cp -R Interference.app Payload/ && ditto -c -k --norsrc --noextattr --keepParent Payload interference.ipa'
scp -q mac:Developer/interference-phone/interference.ipa interference.ipa
"$HOME/Developer/hangar/bin/hangar" put interference.ipa --notes "$(git -C "$repo" log -1 --format=%s)"
echo "Interference $number is on $HANGAR_URL/: tap Install there in Safari on the phone"
